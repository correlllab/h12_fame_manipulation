<mujoco model="h1_2 + workbench table">
  <!-- Robot body. Resolved from this file's directory:
       scenes/  ->  ../../h12_adaptive_policy/h1_2/h1_2_handless.xml -->
  <include file="../../h12_adaptive_policy/h1_2/h1_2_handless.xml"/>

  <statistic center="0.7 0 0.9" extent="1.4"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="flat" rgb1="0 0 0" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
    <material name="table_top" rgba="0.55 0.42 0.28 1.0" reflectance="0.05"/>
    <material name="table_leg" rgba="0.30 0.22 0.15 1.0" reflectance="0.05"/>
    <material name="push_block" rgba="0.85 0.20 0.20 1.0" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="1 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Workbench: 71 3/4" x 29 1/2" x 36 1/16" (1.82245 x 0.7493 x 0.91695 m).
         Length aligned along y. Near edge at world x = 0.20 m (moved 10cm
         closer than before for bimanual reach — both wrists, even with
         FAME's tilted crouch, sit ~7cm OVER the table footprint at z=1.04
         which is 12cm above the table top z=0.917). Block sits on top
         centered at world y=0 so both arms can pick it up. -->
    <body name="table" pos="0.57465 0 0">
      <!-- top slab: 0.7493 (x) * 1.82245 (y) * 0.04 (z), centered at z=0.89695 (top face at z=0.91695) -->
      <geom name="table_top" type="box"
            size="0.37465 0.911225 0.02"
            pos="0 0 0.89695"
            material="table_top"
            friction="1.0 0.005 0.0001"/>
      <!-- four legs: 0.06 x 0.06 cross-section, floor to underside of slab (z=0.87695).
           Leg half-height = 0.438475; placed at the four inner corners (1 cm inset from top edges). -->
      <geom name="table_leg_lf" type="box" size="0.03 0.03 0.438475"
            pos=" 0.34465  0.881225 0.438475" material="table_leg"/>
      <geom name="table_leg_rf" type="box" size="0.03 0.03 0.438475"
            pos=" 0.34465 -0.881225 0.438475" material="table_leg"/>
      <geom name="table_leg_lb" type="box" size="0.03 0.03 0.438475"
            pos="-0.34465  0.881225 0.438475" material="table_leg"/>
      <geom name="table_leg_rb" type="box" size="0.03 0.03 0.438475"
            pos="-0.34465 -0.881225 0.438475" material="table_leg"/>
    </body>

    <!-- Bimanual pick-and-place block — 12 cm cube, centered at world y=0
         on the table top so both wrists can grip it. Axis-aligned (no
         rotation); the previous 45° rotation was for the single-arm push
         experiment and is removed.
            block center world  : (0.30, 0, 0.977)
            block extent xyz    : ±(0.06, 0.06, 0.06)
            block bottom z      : 0.917  (= table top exactly)
            block top z         : 1.037  (≈ wrist height at FAME crouch)
         Mass overridden at reset by PUSH_BLOCK_MASS env var. The block
         keeps its freejoint so it can be physically displaced (welds or
         contact); see <equality> section below for the bimanual welds. -->
    <body name="push_block" pos="0.30 0 0.977">
      <freejoint name="push_block_free"/>
      <!-- 12x20x12 cm box: width (y) bumped to 20 cm so the wrist
           positions at the grip pose (world y = ±0.077) clearly OVERLAP
           the block sides (block faces at ±0.10). The 2-3 cm overlap
           means the wrist visually clamps the block face — looks like a
           tight grip even before the welds activate. After weld
           activation the block is rigidly pinned to both wrists. -->
      <geom name="push_block_geom" type="box"
            size="0.06 0.10 0.06"
            mass="0.5"
            material="push_block"
            friction="1.0 0.005 0.0001"/>
    </body>
  </worldbody>

  <!-- Bimanual welds: block gripped between the two wrists. Initially
       DISABLED (active="false") because the XML compile pose (robot
       standing upright) does NOT place the wrists at the block's sides;
       at runtime the bridge brings the arms into the grip pose, snapshots
       the current relative offsets, writes them into data.eq_data, then
       sets data.eq_active=1 on both welds.
       relpose semantics: body2's pose in body1's frame.
       The relpose values below are placeholders — bridge overwrites them
       at activation time. -->
  <equality>
    <weld name="weld_block_right"
          body1="push_block"
          body2="right_wrist_yaw_link"
          relpose="0 -0.06 0 1 0 0 0"
          active="false"/>
    <weld name="weld_block_left"
          body1="push_block"
          body2="left_wrist_yaw_link"
          relpose="0 +0.06 0 1 0 0 0"
          active="false"/>
  </equality>
</mujoco>
